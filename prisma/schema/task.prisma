model Task {
  id           String       @id @default(uuid())
  title        String       @db.VarChar(200)
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)

  projectId    String
  assignedToId String?
  createdById  String

  dueDate      DateTime?

  isDeleted    Boolean      @default(false)
  deletedAt    DateTime?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  assignedTo User? @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdBy User @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isDeleted])
  @@index([projectId, status])
  @@index([assignedToId, status])
}